# Server-only key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Local development. In Replit Secrets: false + a unique random secret.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY=false
# Optional absolute SQLite path (must be on persistent storage when deployed).
# MOVIEHUB_DB_PATH=/persistent/moviehub.db
# Replit publishing: use the platform PostgreSQL URL, not ephemeral SQLite.
DATABASE_URL=
